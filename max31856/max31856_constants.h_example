/**
 * @file    max31856_constants.h
 * @brief   MCU peripheral binding of the MAX31856 driver.
 * @details Copy this template to max31856_constants.h and adjust the SPI
 *          instance and the CS pin to the board wiring.
 *
 *          Low-level SPI access: either the project layer (MCU/spi.c) or the
 *          spi/ module of this repo - same signatures, but spi/ adds bounded
 *          timeouts (a dead bus fails MAX31856_probe instead of hanging the
 *          firmware). The bus must be configured as SPI mode 1 (CPOL = 0,
 *          CPHA = 1), MSB first, 8-bit data; MAX31856_CS_PIN must be a GPIO
 *          push-pull output (soft NSS). On STM32H7 call SPI_MasterStart()
 *          once after the bus init (CSTART).
 */

#ifndef MAX31856_CONSTANTS_H
#define MAX31856_CONSTANTS_H

/*==============================================================================
 *                              INCLUDED FILES
 *============================================================================*/

#include "spi.h"                 /* or the project MCU/spi.h - same primitives */
#include "stm32h7xx_ll_gpio.h"   /* CS line control */

/*==============================================================================
 *                            MACRO DEFINITIONS
 *============================================================================*/

#define MAX31856_SPI        SPI1            /**< SPI peripheral instance      */
#define MAX31856_CS_GPIO    GPIOA           /**< Port of the chip-select line */
#define MAX31856_CS_PIN     LL_GPIO_PIN_4   /**< Chip-select pin mask         */

/** Receive one byte from the driver SPI. */
#define SPI_RX              SPI_ReceiveData(MAX31856_SPI)
/** Transmit one byte over the driver SPI. */
#define SPI_TX(data)        SPI_SendData(MAX31856_SPI, data)
/** Assert chip select (start of a frame). */
#define MAX31856_CS_LOW     LL_GPIO_ResetOutputPin(MAX31856_CS_GPIO, MAX31856_CS_PIN);
/** Release chip select (end of a frame). */
#define MAX31856_CS_HIGH    LL_GPIO_SetOutputPin(MAX31856_CS_GPIO, MAX31856_CS_PIN);

#endif /* MAX31856_CONSTANTS_H */
