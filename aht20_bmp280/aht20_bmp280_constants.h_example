/**
 * @file    aht20_bmp280_constants.h
 * @brief   MCU peripheral binding of the AHT20 + BMP280 driver.
 * @details Copy this template to aht20_bmp280_constants.h and adjust to the
 *          board. Part of the values (BMP280 address) depends on the module
 *          wiring.
 */

#ifndef AHT20_BMP280_CONSTANTS_H
#define AHT20_BMP280_CONSTANTS_H

/*==============================================================================
 *                              INCLUDED FILES
 *============================================================================*/

#include "stm32h7xx_ll_utils.h"  /* LL_mDelay */

/*==============================================================================
 *                            MACRO DEFINITIONS
 *============================================================================*/

#define AHT_BMP_I2C     I2C1     /**< I2C peripheral shared by both chips     */
#define AHT20_ADDR      0x38U    /**< AHT20 fixed 7-bit address               */
#define BMP280_ADDR     0x76U    /**< BMP280 address (0x77 if SDO tied high)  */

/** Millisecond delay used by the BLOCKING functions while waiting for
 *  conversions. Bare-metal: LL_mDelay needs a running 1 ms SysTick.
 *  Under FreeRTOS remap it so a waiting task yields instead of spinning:
 *      #define AHT_BMP_DELAY_MS(ms)   vTaskDelay(pdMS_TO_TICKS(ms))
 *  The non-blocking trigger/busy/fetch functions never call this macro. */
#define AHT_BMP_DELAY_MS(ms)   LL_mDelay(ms)

#endif /* AHT20_BMP280_CONSTANTS_H */
