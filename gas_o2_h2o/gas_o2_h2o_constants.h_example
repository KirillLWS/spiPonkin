#ifndef GAS_O2_H2O_CONSTANTS_H
#define GAS_O2_H2O_CONSTANTS_H

// Individual graduation data. Part of these values is entered manually
// according to the results of the individual calibration of each unit.

// --- O2 solid-electrolyte cell ---------------------------------------------
// Cx[%] = GAS_O2_C_REF * exp(-k(T) * (Ex - Et)),  k(T) = 4F/(R*T)
// The zirconia cell runs hot, so the Nernst slope k depends on the actual
// cell temperature T, which is measured by the thermocouple (MAX31856).
// k is scaled from its nominal value: k(T) = GAS_O2_NERNST_K * GAS_O2_T_NOM / T.
#define GAS_O2_C_REF      20.7f       // reference O2 volume fraction, %
#define GAS_O2_NERNST_K   51.17975f   // nominal 4F/(R*T) at T = GAS_O2_T_NOM, 1/V
#define GAS_O2_T_NOM      907.15f     // nominal cell temperature, K (634 degC)
#define GAS_O2_ET         0.0f        // thermo-EMF Et correction, V (from calibration)

// --- H2O coulometric sensor ------------------------------------------------
// C_H2O[ppmV] = GAS_H2O_K * (Ux - Uf) / Q
#define GAS_H2O_K         747.928f    // ppmV * (cm^3/min) / V
#define GAS_H2O_UF        0.0f        // background-current voltage Uf, V (from calibration)
#define GAS_H2O_RESISTOR  100.0f      // sense resistor across which Ux is measured, Ohm

// --- Flow rate Q = a + b*x + c*x^2 (x - flow-meter output signal) -----------
#define GAS_FLOW_O2_A     0.415392f
#define GAS_FLOW_O2_B     13766.5f
#define GAS_FLOW_O2_C     35416.67f

#define GAS_FLOW_H2O_A    0.9615185f
#define GAS_FLOW_H2O_B    12611.44f
#define GAS_FLOW_H2O_C    37579.19f

// --- Validity limits for the *_checked functions ----------------------------
// Tune per unit. Out-of-range inputs make exp()/division produce plausible
// looking garbage, so checked variants reject them instead.
#define GAS_O2_EX_MIN     (-0.2f)     // valid cell EMF range, V
#define GAS_O2_EX_MAX     0.5f
#define GAS_O2_T_MIN      773.15f     // cell working temperature range, K (500 degC)
#define GAS_O2_T_MAX      1073.15f    // (800 degC)
#define GAS_H2O_UX_MAX    10.0f       // max plausible sense voltage, V
#define GAS_FLOW_Q_MIN    0.001f      // min plausible flow, cm^3/min

#endif
